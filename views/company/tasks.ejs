<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Manage Tasks | TaskFlow</title>

    <link rel="stylesheet" href="/css/adminNavbar.css">
    <link rel="stylesheet" href="/css/adminSidebar.css">
    <link rel="stylesheet" href="/css/tasks.css">

</head>

<body>

    <%- include("../partials/adminNavbar") %>
    <%- include("../partials/flash") %>

    <div class="dashboard">

        <%- include("../partials/adminSidebar") %>

        <main class="content">
            

            <div class="page-header">
                <div class="filter-box">

<form action="/company/tasks" method="GET">

<input
type="text"
name="search"
placeholder="Search task..."
value="<%= search || '' %>"
>

<select name="status">

<option value="">All Status</option>

<option value="Pending"
<%= status==="Pending" ? "selected":"" %>>
Pending
</option>

<option value="In Progress"
<%= status==="In Progress" ? "selected":"" %>>
In Progress
</option>

<option value="Completed"
<%= status==="Completed" ? "selected":"" %>>
Completed
</option>

</select>

<select name="priority">

<option value="">All Priority</option>

<option value="High"
<%= priority==="High" ? "selected":"" %>>
High
</option>

<option value="Medium"
<%= priority==="Medium" ? "selected":"" %>>
Medium
</option>

<option value="Low"
<%= priority==="Low" ? "selected":"" %>>
Low
</option>

</select>

<button>

Search

</button>

</form>

</div>

                <h1>Manage Tasks</h1>

                <a href="/company/create-task">
                    + Create Task
                </a>

            </div>

            <% if(tasks.length === 0){ %>

                <div class="empty-state">

                    <h2>No Tasks Found</h2>

                    <p>Create your first task to get started.</p>

                </div>

            <% } else { %>

                <div class="table-container">

                    <table>

                        <thead>

                            <tr>

                                <th>Title</th>
                                <th>Employee</th>
                                <th>Priority</th>
                                <th>Status</th>
                                <th>Due Date</th>
                                <th>Actions</th>

                            </tr>

                        </thead>

                        <tbody>

                            <% tasks.forEach(task => { %>

                                <tr>

                                    <td>

                                        <strong><%= task.title %></strong>

                                    </td>

                                    <td>

                                        <%= task.full_name || "Not Assigned" %>

                                    </td>

                                    <td>

                                        <span class="priority <%= task.priority.toLowerCase() %>">

                                            <%= task.priority %>

                                        </span>

                                    </td>

                                    <td>

                                        <span class="status <%= task.status.toLowerCase().replace(' ','-') %>">

                                            <%= task.status %>

                                        </span>

                                    </td>

                                    <td>

                                        <%= task.due_date ? new Date(task.due_date).toLocaleDateString() : "-" %>

                                    </td>

                                    <td>

                                        <div class="actions">

    <a
        href="/company/task/<%= task.id %>"
        class="btn-view">

        View

    </a>

    <a
        href="/company/task/edit/<%= task.id %>"
        class="btn-edit">

        Edit

    </a>

    <form
        action="/company/task/delete/<%= task.id %>"
        method="POST"
        onsubmit="return confirm('Delete this task?')">

        <button
            class="btn-delete">

            Delete

        </button>

    </form>

</div>

                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                </div>

            <% } %>

        </main>

    </div>

</body>

</html>