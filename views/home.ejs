<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TaskFlow | Smart Task Management</title>

    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- CSS -->
    <link rel="stylesheet" href="/css/global.css">
<link rel="stylesheet" href="/css/navbar.css">
<link rel="stylesheet" href="/css/home.css">
<link rel="stylesheet" href="/css/footer.css">
</head>
<body>

    <!-- Navbar -->
    <%- include("./partials/navbar") %>

    <%- include("./partials/flash") %>

    <!-- Hero Section -->
    <section class="hero">

        <div class="container">

            <div class="hero-content">

                <span class="hero-tag">
                    🚀 Smart Task Management
                </span>

                <h1>
                    Manage Your Company <span>Smarter</span> Than Ever
                </h1>

                <p>
                    TaskFlow helps companies assign tasks, track employee progress,
                    approve employee requests, and manage projects from one powerful dashboard.
                </p>

                <div class="hero-buttons">

                    <a href="/company/register" class="primary-btn">
                        Register Company
                    </a>

                    <a href="/employee/login" class="secondary-btn">
                        Employee Login
                    </a>

                </div>

            </div>

            <div class="hero-image">

                <img src="/images/dashboard.jpg" alt="TaskFlow Dashboard">

            </div>

        </div>

    </section>

   <!-- ================= FEATURES ================= -->

<section class="features" id="features">

    <div class="container">

        <div class="section-title">

            <h2>Everything You Need To Manage Your Team</h2>

            <p>
                Powerful features designed for companies to manage employees,
                assign tasks, and track progress efficiently.
            </p>

        </div>

        <div class="feature-grid">

            <div class="feature-card">

                <div class="icon">📋</div>

                <h3>Create Tasks</h3>

                <p>
                    Create daily, weekly, or monthly tasks in just a few clicks.
                </p>

            </div>

            <div class="feature-card">

                <div class="icon">👨‍💼</div>

                <h3>Manage Employees</h3>

                <p>
                    Approve employee requests and organize your workforce easily.
                </p>

            </div>

            <div class="feature-card">

                <div class="icon">📈</div>

                <h3>Track Progress</h3>

                <p>
                    Monitor every task with live progress updates.
                </p>

            </div>

            <div class="feature-card">

                <div class="icon">📊</div>

                <h3>Analytics</h3>

                <p>
                    View completed, pending, and overdue tasks using reports.
                </p>

            </div>

        </div>

    </div>

</section>

<!-- ================= CTA ================= -->

<section class="cta">

    <div class="container">

        <h2>Ready To Manage Your Company Smarter?</h2>

        <p>
            Join TaskFlow today and organize your company's workflow effortlessly.
        </p>

        <a href="/company/register" class="primary-btn">
            Register Your Company
        </a>

    </div>

</section>


    </section>

    <!-- Footer -->
    <%- include("./partials/footer") %>

    <script src="/js/navbar.js"></script>
</body>
</html>